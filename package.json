{
  "name": "polyscope",
  "version": "1.0.0",
  "description": "Production-grade backend for predicting Polymarket outcomes",
  "main": "index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "refresh": "node src/cron/computePredictions.js",
    "setup": "node scripts/create-admin-user.js",
    "backup": "node scripts/backup.js",
    "init-db": "mongosh < scripts/init-indexes.js",
    "generate-keys": "node scripts/generate-vapid-keys.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:unit": "jest --testPathPattern=__tests__",
    "test:integration": "jest --testPathPattern=integration",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "keywords": [
    "polymarket",
    "prediction",
    "llm",
    "backend"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@google/generative-ai": "^0.19.0",
    "axios": "^1.7.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.3.1",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "mongoose": "^8.5.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^6.9.14",
    "web-push": "^3.6.7",
    "winston": "^3.13.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.57.0"
  }
}
