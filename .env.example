# Server Configuration
PORT=5000
NODE_ENV=development

# CORS Configuration
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourapp.com

# MongoDB
MONGODB_URI=mongodb://localhost:27017/polyscope

# Polymarket API
POLYMARKET_API_BASE=https://gamma-api.polymarket.com
# No Polymarket API key required

# LLM Configuration (Google Gemini)
# Get your API key from: https://makersuite.google.com/app/apikey
LLM_API_KEY=your_gemini_api_key_here

# Email Service (Testmail.app or custom SMTP)
EMAIL_SERVICE_HOST=smtp.testmail.app
SMTP_HOST=smtp.testmail.app
EMAIL_SERVICE_PORT=587
SMTP_PORT=587
EMAIL_SERVICE_USER=your_testmail_username
SMTP_USER=your_testmail_username
EMAIL_SERVICE_PASS=your_testmail_password
SMTP_PASS=your_testmail_password
EMAIL_FROM_ADDRESS=notifications@polyscope.app
EMAIL_FROM=noreply@polyscope.com
EMAIL_FROM_NAME=Polyscope Notifications

# Web Push Notifications (VAPID)
# Generate keys with: npm run generate-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@polyscope.com

# Admin Configuration
ADMIN_API_KEY=your_admin_api_key_here
ADMIN_EMAIL=admin@polyscope.app
ADMIN_PASSWORD=your_secure_admin_password_here

# Cache Configuration
CACHE_TTL=300
CACHE_CHECK_PERIOD=600

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
PREDICTION_RATE_LIMIT=20

# Notification Configuration
NOTIFICATION_THRESHOLD=10

# Webhook Configuration (optional)
WEBHOOK_SECRET=your_webhook_secret_here

# Logging
LOG_LEVEL=info
LOG_FILE=logs/app.log

# Feature Flags (optional)
ENABLE_NOTIFICATIONS=true
ENABLE_WEBHOOKS=false
ENABLE_METRICS=true

# Rate Limit Bypass (Dev IP)
DEV_IP=127.0.0.1

