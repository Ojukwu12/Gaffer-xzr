# Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5000

# CORS Configuration
# Comma-separated list of allowed origins for CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,https://yourapp.com

# MongoDB
MONGODB_URI=mongodb://localhost:27017/polyscope

# Polymarket API
POLYMARKET_API_BASE=https://gamma-api.polymarket.com
# No Polymarket API key required

# External Data APIs (Sports + Financial)
# TheSportsDB (free multi-sport source)
# Free public key is "3". You can keep this default value.
THESPORTSDB_API_KEY=3
THESPORTSDB_BASE_URL=https://www.thesportsdb.com/api/v1/json

# Football-Data.org (free-tier soccer source)
FOOTBALL_DATA_API_KEY=your_football_data_api_key_here
FOOTBALL_DATA_BASE_URL=https://api.football-data.org/v4

# Financial data sources
# CoinGecko is used for crypto markets (public API)
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
# Yahoo Finance endpoint is used for stock/economy markets
YAHOO_FINANCE_BASE_URL=https://query1.finance.yahoo.com

# External Data APIs (Geopolitical + Corporate)
# GDELT Project (Global event database for geopolitical analysis)
# Get API key from: https://gdeltproject.org/
GDELT_API_KEY=your_gdelt_api_key_here
GDELT_BASE_URL=https://api.gdeltproject.org

# NewsAPI (Used for political, geopolitical, and corporate news analysis)
# Get API key from: https://newsapi.org/
NEWS_API_KEY=your_news_api_key_here

# SEC EDGAR (For corporate/tech market filings and regulatory analysis)
# Public API - no key required
SEC_EDGAR_API_BASE=https://data.sec.gov/api/xbrl

# Earnings Calendar API (For corporate earnings predictions)
EARNINGS_API_KEY=your_earnings_api_key_here
EARNINGS_API_BASE=https://api.example.com/earnings

# External data layer cache TTL (seconds)
EXTERNAL_DATA_CACHE_TTL=900

# LLM Configuration (Google Gemini - Primary)
# Get your API key from: https://makersuite.google.com/app/apikey
# Either LLM_API_KEY or GEMINI_API_KEY is accepted
LLM_API_KEY=your_gemini_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Secondary LLM (Fallback for rate limiting)
# Options: 'claude' (Anthropic) or 'ollama' (self-hosted)
SECONDARY_LLM_PROVIDER=
SECONDARY_LLM_API_KEY=
SECONDARY_LLM_MODEL=claude-3-5-sonnet-20241022
OLLAMA_BASE_URL=http://localhost:11434

# Email Service (Brevo API)
# Get your API key from: https://app.brevo.com/settings/account/api
BREVO_API_KEY=your_brevo_api_key_here
EMAIL_FROM_ADDRESS=obiefunaokechukwu98@gmail.com
EMAIL_FROM_NAME=Polyscope Notifications

# Web Push Notifications (VAPID)
# Generate keys with: npm run generate-keys
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
VAPID_SUBJECT=mailto:admin@polyscope.com

# Admin Configuration
ADMIN_API_KEY=your_admin_api_key_here
ADMIN_EMAIL=admin@polyscope.app
ADMIN_APPROVAL_ALERT_ENABLED=true
ADMIN_SECRET_KEY=set_a_long_random_admin_secret

# Cache Configuration
CACHE_TTL=300

# Notification Configuration
NOTIFICATION_THRESHOLD=10

# Prediction Engine Configuration
# Limit markets processed to reduce AI rate limiting
MAX_MARKETS_PER_RUN=20
MARKETS_PER_CATEGORY=1
# Starter defaults to avoid frequent zero-market runs in low-liquidity periods.
# Tighten these later as your market coverage and confidence improve.
MIN_LIQUIDITY_USD=250
MIN_VOLUME_24H_USD=25
MIN_PREDICTABILITY_SCORE=65
MIN_PREDICTION_CONFIDENCE=70
MIN_PROBABILITY_DIFFERENCE=10
MIN_EXPECTED_EDGE_SCORE=55
MIN_WIN_RATE_LOWER_BOUND=51
PREDICTION_MODE=paper
READINESS_MIN_RESOLVED=100
READINESS_WINDOW_DAYS=30
READINESS_MODE=paper
ENFORCE_PRODUCTION_READINESS=false

# Timing Security (prevent predictable generation/publication patterns)
# Add random delay before scheduled prediction computation
PREDICTION_CRON_JITTER_MIN_MS=120000
PREDICTION_CRON_JITTER_MAX_MS=600000
# Optional jitter for market refresh job
REFRESH_CRON_JITTER_MIN_MS=30000
REFRESH_CRON_JITTER_MAX_MS=180000
# Delay public visibility after admin approval (randomized)
PREDICTION_PUBLISH_DELAY_MIN_MS=120000
PREDICTION_PUBLISH_DELAY_MAX_MS=480000

# Internal ML Correction Layer (post-AI probability tuning)
ML_CORRECTION_ENABLED=true
ML_CORRECTION_LEARNING_RATE=0.03
ML_CORRECTION_MAX_ADJUSTMENT=6
ML_CORRECTION_MIN_SAMPLES=40
ML_CORRECTION_BLEND_MAX=0.35
# Optional override path for persisted model state (defaults to data/ml-correction-model.json)
ML_CORRECTION_MODEL_PATH=
# Safeguards
ML_CORRECTION_CONFIDENCE_THRESHOLD=0.6
ML_CORRECTION_MIN_LIQUIDITY_USD=1000
ML_CORRECTION_MAX_VOLATILITY=0.35
ML_CORRECTION_CATEGORY_MODELS_ENABLED=true
# Periodic retraining controls
ML_CORRECTION_RETRAIN_EVERY_N=20
ML_CORRECTION_RETRAIN_WINDOW_DAYS=180
ML_CORRECTION_RETRAIN_MAX_SAMPLES=3000
ML_CORRECTION_EPOCHS=4

# LLM Rate Limiting & Retry
LLM_MAX_RETRIES=3
LLM_RETRY_DELAY_MS=1000
LLM_RATE_LIMIT_THRESHOLD=3

# Outbound External API Rate Limiting (minimum interval between calls)
THESPORTSDB_MIN_INTERVAL_MS=700
FOOTBALL_DATA_MIN_INTERVAL_MS=500
COINGECKO_MIN_INTERVAL_MS=1200
YAHOO_FINANCE_MIN_INTERVAL_MS=400
GDELT_MIN_INTERVAL_MS=600
NEWS_API_MIN_INTERVAL_MS=800
SEC_EDGAR_MIN_INTERVAL_MS=500
EARNINGS_API_MIN_INTERVAL_MS=500

# Vote Integrity and Anti-Manipulation
# Cooldown before a user/device can change vote
VOTE_COOLDOWN_MS=60000
# Minimum sample size before exposing crowd percentage
VOTE_RELIABLE_SAMPLE_SIZE=20
# Burst analysis window and threshold
VOTE_BURST_WINDOW_MS=300000
VOTE_BURST_THRESHOLD=40
# Max allowed single-IP share before downweighting
VOTE_BURST_MAX_SINGLE_IP_SHARE=0.6
# Account-age based vote weighting
VOTE_NEW_ACCOUNT_DAYS=7
VOTE_RECENT_ACCOUNT_DAYS=30
VOTE_NEW_ACCOUNT_WEIGHT=0.5
VOTE_RECENT_ACCOUNT_WEIGHT=0.8
# Suspicious-activity vote weighting
VOTE_VELOCITY_SPIKE_WEIGHT=0.7
VOTE_IP_CONCENTRATION_WEIGHT=0.5
VOTE_MIN_WEIGHT=0.3

# Logging
LOG_LEVEL=info

# Rate Limit Bypass (Dev IP)
DEV_IP=127.0.0.1

